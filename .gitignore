# ==============================================
# Third-Party Libraries (Git Submodules)
# ==============================================
# Ignore all contents except configuration files
third_party/*

# Keep essential files
!third_party/README.md
!third_party/CMakeLists.txt

# Allow submodule marker files (required for git submodules)
!third_party/ncnn/
!third_party/MNN/
!third_party/TNN/
!third_party/tvm/
!third_party/onnxruntime/
!third_party/tflite_extracted/
!third_party/QNN/

# But ignore build artifacts inside submodules
third_party/*/build/
third_party/*/build*/
third_party/*/*.so
third_party/*/*.a
third_party/*/*.lib
third_party/*/CMakeCache.txt
third_party/*/CMakeFiles/

# ==============================================
# Model files (large binary files)
# ==============================================
*.onnx
*.bin
*.param
*.mnn
*.tflite
*.qnn
*.so
*.dll
*.dylib
*.a
*.lib
*.aar

# Model directories
models/classification/*.onnx
models/classification/*.mnn
models/classification/*.tflite
models/classification/*.param
models/classification/*.bin
models/detection/*
models/nlp/*

# ==============================================
# Results
# ==============================================
results/*
!results/.gitkeep

